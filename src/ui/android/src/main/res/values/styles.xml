<resources>
    <style name="Theme.RoadGuardian" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">@font/asta_sans</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="Theme.RoadGuardian.EventPopup" parent="Theme.RoadGuardian">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.25</item>
        <item name="android:windowCloseOnTouchOutside">true</item>
    </style>
</resources>
